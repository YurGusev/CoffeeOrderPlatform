{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffeeorder.local/contracts/kafka/paymentrefundrequested.v1.schema.json",
  "title": "PaymentRefundRequested.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "refundRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "paymentIntentRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "paymentRequirementRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "orderRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "amountMinor": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "compensationRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "refundRef",
    "paymentIntentRef",
    "paymentRequirementRef",
    "orderRef",
    "amountMinor",
    "currency",
    "compensationRef",
    "reasonCode"
  ]
}
