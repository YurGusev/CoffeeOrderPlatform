{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffeeordersystem.local/schemas/aroma-preparation-requested.v1.schema.json",
  "title": "AromaPreparationRequested.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "orderRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "orderVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "profileName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "desiredRevision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    }
  },
  "required": [
    "orderRef",
    "orderVersion",
    "profileName",
    "desiredRevision"
  ]
}
