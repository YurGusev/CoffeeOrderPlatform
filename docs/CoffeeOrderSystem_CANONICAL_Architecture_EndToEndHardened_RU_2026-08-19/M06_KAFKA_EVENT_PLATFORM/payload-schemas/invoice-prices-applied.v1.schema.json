{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffeeorder.local/contracts/kafka/invoicepricesapplied.v1.schema.json",
  "title": "InvoicePricesApplied.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "clientInvoiceRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "checkoutSnapshotRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "wholesaleSnapshotRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "priceProofManifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifactRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byteSize": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "schemaVersion": {
          "const": 1
        }
      },
      "required": [
        "artifactRef",
        "sha256",
        "byteSize",
        "schemaVersion"
      ]
    },
    "orderProofs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "orderRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "orderVersionAtCheckout": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "amountMinor": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "lineCoverageHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "orderRef",
          "orderVersionAtCheckout",
          "amountMinor",
          "currency",
          "lineCoverageHash"
        ]
      }
    }
  },
  "required": [
    "clientInvoiceRef",
    "checkoutSnapshotRef",
    "wholesaleSnapshotRef",
    "priceProofManifest",
    "orderProofs"
  ]
}
