{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffeeordersystem.local/schemas/aroma-convergence-result.v1.schema.json",
  "title": "AromaConvergenceResult.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "profileName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "cartKeyHash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "desiredKeyVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "Verified",
        "Blocked",
        "UnknownOutcome",
        "Superseded"
      ]
    },
    "attemptRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "profileName",
    "cartKeyHash",
    "desiredKeyVersion",
    "outcome",
    "attemptRef"
  ]
}
