{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffeeordersystem.local/schemas/order-completed.v1.schema.json",
  "title": "OrderCompleted.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "orderRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "orderVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "completionProofType": {
      "type": "string",
      "enum": [
        "ProviderPayment",
        "ManualPayment"
      ]
    },
    "paymentProofRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "orderRef",
    "orderVersion",
    "completionProofType"
  ]
}
