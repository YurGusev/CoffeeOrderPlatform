{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffeeorder.local/contracts/kafka/agentturnrequested.v1.schema.json",
  "title": "AgentTurnRequested.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "turnRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "conversationRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "channelIdentityRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "identityEpoch": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "turnSequence": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "inboundMessageRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "messageText": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "confirmationProofRef": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "requestedAtUtc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "turnRef",
    "conversationRef",
    "channelIdentityRef",
    "identityEpoch",
    "turnSequence",
    "inboundMessageRef",
    "requestedAtUtc"
  ]
}
