{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffeeordersystem.local/schemas/payment-succeeded.v1.schema.json",
  "title": "PaymentSucceeded.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "paymentIntentRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "paymentRequirementRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "orderRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "amountMinor": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "proofRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "paymentIntentRef",
    "paymentRequirementRef",
    "orderRef",
    "amountMinor",
    "currency",
    "proofRef"
  ]
}
