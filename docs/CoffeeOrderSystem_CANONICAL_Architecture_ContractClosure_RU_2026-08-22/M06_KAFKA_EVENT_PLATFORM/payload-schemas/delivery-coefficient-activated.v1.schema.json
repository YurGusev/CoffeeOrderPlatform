{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "delivery-coefficient-activated",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "deliveryCoefficientVersionRef": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "percent": {
      "type": "string",
      "pattern": "^\\d+(?:\\.\\d{1,4})?$"
    },
    "source": {
      "enum": [
        "InitialPolicy",
        "ActualProcurementBatch",
        "ManualApproved"
      ]
    },
    "basedOnProcurementBatchRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "effectiveAtUtc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "deliveryCoefficientVersionRef",
    "version",
    "percent",
    "source",
    "effectiveAtUtc"
  ]
}
