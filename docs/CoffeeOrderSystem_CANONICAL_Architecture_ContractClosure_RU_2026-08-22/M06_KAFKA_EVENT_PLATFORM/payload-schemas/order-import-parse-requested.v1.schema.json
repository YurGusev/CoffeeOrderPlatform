{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "order-import-parse-requested",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "importJobRef": {
      "type": "string",
      "minLength": 1
    },
    "artifactRef": {
      "type": "string",
      "minLength": 1
    },
    "artifactSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "importRevision": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "requestedBy": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "importJobRef",
    "artifactRef",
    "artifactSha256",
    "importRevision",
    "requestedBy"
  ]
}
