{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffeeordersystem.local/schemas/channel-media-processing-requested.v1.schema.json",
  "title": "ChannelMediaProcessingRequested",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "conversationKeyHash",
    "sourceArtifactRef",
    "sourceSha256",
    "sourceSizeBytes",
    "mediaKind",
    "correlationId"
  ],
  "properties": {
    "conversationKeyHash": {"type": "string", "minLength": 16, "maxLength": 128},
    "sourceArtifactRef": {"type": "string", "pattern": "^art_[A-Za-z0-9_-]+$"},
    "sourceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceSizeBytes": {"type": "string", "pattern": "^[0-9]+$"},
    "mediaKind": {"type": "string", "enum": ["voice", "audio", "document"]},
    "declaredMimeType": {"type": ["string", "null"], "maxLength": 128},
    "correlationId": {"type": "string", "minLength": 8, "maxLength": 128}
  }
}
