{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffeeordersystem.local/contracts/m21/owner-command-matrix.v1.schema.json",
  "title": "M21 typed owner-command matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contractId",
    "status",
    "owner",
    "scope",
    "commandEnvelope",
    "commands",
    "denials",
    "evidenceOwner",
    "evidenceRefs"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "contractId": { "type": "string", "pattern": "^m21-owner-command-matrix-[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "status": { "const": "SPECIFICATION_ONLY" },
    "owner": { "const": "operator-work-center" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readModelOwner", "businessStateOwner", "workCenterDatabaseWrites", "queueResolution", "acceptedActionCount"],
      "properties": {
        "readModelOwner": { "const": "operator-work-center" },
        "businessStateOwner": { "const": "command-owning-bounded-context" },
        "workCenterDatabaseWrites": { "const": "forbidden" },
        "queueResolution": { "const": "requires-authoritative-owner-fact" },
        "acceptedActionCount": { "const": 8 }
      }
    },
    "commandEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "reason", "expectedVersionOrFingerprint", "idempotency", "trace", "workCenterItemRef"],
      "properties": {
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "source", "clientSupplied", "capabilityCheckedByServer"],
          "properties": {
            "required": { "const": true },
            "source": { "type": "string", "minLength": 1 },
            "clientSupplied": { "const": false },
            "capabilityCheckedByServer": { "const": true }
          }
        },
        "reason": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "source", "persistedInAudit", "blankOrMissing"],
          "properties": {
            "required": { "const": true },
            "source": { "type": "string", "minLength": 1 },
            "persistedInAudit": { "const": true },
            "blankOrMissing": { "const": "reject" }
          }
        },
        "expectedVersionOrFingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "source", "checkedByOwnerBeforeWrite", "staleResult"],
          "properties": {
            "required": { "const": true },
            "source": { "type": "string", "minLength": 1 },
            "checkedByOwnerBeforeWrite": { "const": true },
            "staleResult": { "const": "reject-without-business-write" }
          }
        },
        "idempotency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["header", "required", "serverGeneratedFallback", "scope"],
          "properties": {
            "header": { "const": "Idempotency-Key" },
            "required": { "const": true },
            "serverGeneratedFallback": { "const": false },
            "scope": { "type": "string", "minLength": 1 }
          }
        },
        "trace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["correlationId", "causationId"],
          "properties": {
            "correlationId": {
              "type": "object",
              "additionalProperties": false,
              "required": ["required", "source"],
              "properties": {
                "required": { "const": true },
                "source": { "type": "string", "minLength": 1 }
              }
            },
            "causationId": {
              "type": "object",
              "additionalProperties": false,
              "required": ["required", "source"],
              "properties": {
                "required": { "const": true },
                "source": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "workCenterItemRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "purpose"],
          "properties": {
            "required": { "const": true },
            "purpose": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "canonicalAction",
          "accepted",
          "method",
          "route",
          "operationId",
          "owningBoundedContext",
          "owner",
          "capability",
          "actor",
          "reason",
          "expectedVersionOrFingerprint",
          "idempotencyKey",
          "correlationAndCausation",
          "auditEvent",
          "outbox",
          "authoritativeCompletionFact",
          "completionFact",
          "rollback",
          "evidenceOwner",
          "evidenceRefs"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "canonicalAction": { "type": "string", "minLength": 1 },
          "accepted": { "const": true },
          "method": { "const": "POST" },
          "route": { "type": "string", "pattern": "^/api/(client-v1|agent-v1|internal-v1)/[^ ]+$" },
          "operationId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]+$" },
          "owningBoundedContext": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "capability": { "type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$" },
          "actor": {
            "type": "object",
            "additionalProperties": false,
            "required": ["serverDerived", "clientSupplied", "source"],
            "properties": {
              "serverDerived": { "const": true },
              "clientSupplied": { "const": false },
              "source": { "type": "string", "minLength": 1 }
            }
          },
          "reason": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required", "field", "storedWithCommandAudit"],
            "properties": {
              "required": { "const": true },
              "field": { "const": "reason" },
              "storedWithCommandAudit": { "const": true }
            }
          },
          "expectedVersionOrFingerprint": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required", "fields", "kind"],
            "properties": {
              "required": { "const": true },
              "fields": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "kind": { "type": "string", "minLength": 1 }
            }
          },
          "idempotencyKey": {
            "type": "object",
            "additionalProperties": false,
            "required": ["header", "required"],
            "properties": {
              "header": { "const": "Idempotency-Key" },
              "required": { "const": true }
            }
          },
          "correlationAndCausation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["correlationId", "causationId", "serverGeneratedOrPropagated"],
            "properties": {
              "correlationId": { "const": "required" },
              "causationId": { "const": "required" },
              "serverGeneratedOrPropagated": { "const": true }
            }
          },
          "auditEvent": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required", "eventType", "eventId", "fields", "owner"],
            "properties": {
              "required": { "const": true },
              "eventType": { "type": "string", "minLength": 1 },
              "eventId": { "const": "server-generated" },
              "fields": { "type": "array", "minItems": 6, "items": { "type": "string", "minLength": 1 } },
              "owner": { "type": "string", "minLength": 1 }
            }
          },
          "outbox": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required", "owner", "transactional", "publication", "topic", "topicReason"],
            "properties": {
              "required": { "const": true },
              "owner": { "type": "string", "minLength": 1 },
              "transactional": { "const": true },
              "publication": { "type": "string", "minLength": 1 },
              "topic": { "type": ["string", "null"] },
              "topicReason": { "type": "string", "minLength": 1 }
            }
          },
          "authoritativeCompletionFact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required", "facts", "queueMayResolveOnlyAfterFact", "evidence"],
            "properties": {
              "required": { "const": true },
              "facts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "queueMayResolveOnlyAfterFact": { "const": true },
              "unknownOutcome": { "type": "string", "minLength": 1 },
              "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          },
          "completionFact": { "type": "string", "minLength": 1 },
          "rollback": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required", "owner", "policy", "blindRetry", "workCenterSql"],
            "properties": {
              "required": { "const": true },
              "owner": { "type": "string", "minLength": 1 },
              "policy": { "type": "string", "minLength": 1 },
              "blindRetry": { "const": false },
              "workCenterSql": { "const": false }
            }
          },
          "evidenceOwner": { "const": "next-work-center" },
          "evidenceRefs": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "denials": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision", "operationIdPattern", "reason"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "decision": { "const": "DENY" },
          "routePattern": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "operationIdPattern": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidenceOwner": { "const": "next-work-center" },
    "evidenceRefs": { "type": "array", "minItems": 4, "items": { "type": "string", "minLength": 1 } }
  }
}
