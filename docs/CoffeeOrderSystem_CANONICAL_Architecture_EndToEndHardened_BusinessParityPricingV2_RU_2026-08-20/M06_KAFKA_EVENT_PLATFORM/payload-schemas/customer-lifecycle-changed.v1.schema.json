{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "customer-lifecycle-changed",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "customerRef": {
      "type": "string",
      "minLength": 1
    },
    "customerVersion": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "status": {
      "enum": [
        "Active",
        "Deactivated",
        "Merged",
        "Anonymized"
      ]
    },
    "redirectCustomerRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "occurredAtUtc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "customerRef",
    "customerVersion",
    "status",
    "occurredAtUtc"
  ]
}
