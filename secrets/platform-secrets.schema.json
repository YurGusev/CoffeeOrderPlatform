{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffee-platform.invalid/schemas/platform-secrets.schema.json",
  "title": "CoffeeOrderPlatform encrypted secrets",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environments", "sops"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "environments": {
      "type": "object", "additionalProperties": false,
      "required": ["development", "staging", "production"],
      "properties": {
        "development": {"$ref": "#/$defs/environment"},
        "staging": {"$ref": "#/$defs/environment"},
        "production": {"$ref": "#/$defs/environment"}
      }
    },
    "sops": {"$ref": "#/$defs/sops"}
  },
  "$defs": {
    "encrypted": {"type": "string", "pattern": "^ENC\\[AES256_GCM,data:[^,]+,iv:[^,]+,tag:[^,]+,type:(str|bytes)\\]$"},
    "username": {"type": "string", "enum": ["coffee_customer_rw", "coffee_catalog_import_rw", "coffee_catalog_activate_rw", "coffee_catalog_api_ro", "coffee_pricing_rw", "coffee_orders_service_rw", "coffee_orders_prepare_rw", "coffee_orders_observer_rw", "coffee_orders_convergence_rw", "coffee_aroma_gateway_rw", "catalog", "orders", "realtime"]},
    "credential": {
      "type": "object", "additionalProperties": false, "required": ["username", "password"],
      "properties": {"username": {"$ref": "#/$defs/username"}, "password": {"$ref": "#/$defs/encrypted"}}
    },
    "postgres": {
      "type": "object", "additionalProperties": false, "required": ["customer", "catalogImport", "catalogActivate", "catalogApi", "pricing", "ordersService", "ordersPreparation", "aromaObserver", "aromaConvergence", "aromaGateway"],
      "properties": {
        "customer": {"$ref": "#/$defs/credential"}, "catalogImport": {"$ref": "#/$defs/credential"}, "catalogActivate": {"$ref": "#/$defs/credential"}, "catalogApi": {"$ref": "#/$defs/credential"}, "pricing": {"$ref": "#/$defs/credential"}, "ordersService": {"$ref": "#/$defs/credential"}, "ordersPreparation": {"$ref": "#/$defs/credential"}, "aromaObserver": {"$ref": "#/$defs/credential"}, "aromaConvergence": {"$ref": "#/$defs/credential"}, "aromaGateway": {"$ref": "#/$defs/credential"}
      }
    },
    "kafka": {
      "type": "object", "additionalProperties": false, "required": ["catalog", "orders", "realtime"],
      "properties": {"catalog": {"$ref": "#/$defs/credential"}, "orders": {"$ref": "#/$defs/credential"}, "realtime": {"$ref": "#/$defs/credential"}}
    },
    "security": {
      "type": "object", "additionalProperties": false, "required": ["actorContextEdgeSigningPrivateKey", "actorContextEdgeVerificationPublicKeys", "apiPublicDelegationSigningPrivateKey", "apiInternalDelegationSigningPrivateKey", "catalogCursorSigningPrivateKey", "customerCursorSigningPrivateKey", "customerCursorVerificationPublicKeys", "delegationVerificationKeys", "serviceVerificationKeys", "serviceTransportKeys"],
      "properties": {
        "actorContextEdgeSigningPrivateKey": {"$ref": "#/$defs/encrypted"},
        "actorContextEdgeVerificationPublicKeys": {"$ref": "#/$defs/verificationKeyPair"},
        "apiPublicDelegationSigningPrivateKey": {"$ref": "#/$defs/encrypted"},
        "apiInternalDelegationSigningPrivateKey": {"$ref": "#/$defs/encrypted"},
        "ordersServiceDelegationSigningPrivateKey": {"$ref": "#/$defs/encrypted"},
        "pricingServiceDelegationSigningPrivateKey": {"$ref": "#/$defs/encrypted"},
        "catalogCursorSigningPrivateKey": {"$ref": "#/$defs/encrypted"},
        "customerCursorSigningPrivateKey": {"$ref": "#/$defs/encrypted"},
        "customerCursorVerificationPublicKeys": {"$ref": "#/$defs/verificationKeyPair"},
        "delegationVerificationKeys": {
          "type": "object", "additionalProperties": false, "required": ["api-public", "api-internal"],
          "properties": {"api-public": {"$ref": "#/$defs/verificationKeyPair"}, "api-internal": {"$ref": "#/$defs/verificationKeyPair"}}
        },
        "serviceVerificationKeys": {
          "type": "object", "additionalProperties": false, "required": ["orders-service"],
          "properties": {"orders-service": {"$ref": "#/$defs/verificationKeyPair"}, "pricing-service": {"$ref": "#/$defs/verificationKeyPair"}}
        },
        "serviceTransportKeys": {
          "type": "object", "additionalProperties": false, "required": [
            "edge-gateway", "api-public", "api-internal", "customer-service", "catalog-service",
            "catalog-supplier-sync", "catalog-activation-worker", "pricing-service", "orders-service",
            "orders-aroma-preparation", "aroma-observer", "aroma-convergence", "aroma-gateway", "realtime-gateway"
          ],
          "properties": {
            "edge-nginx": {"$ref": "#/$defs/encrypted"},
            "edge-gateway": {"$ref": "#/$defs/encrypted"}, "api-public": {"$ref": "#/$defs/encrypted"}, "api-internal": {"$ref": "#/$defs/encrypted"}, "web": {"$ref": "#/$defs/encrypted"}, "customer-service": {"$ref": "#/$defs/encrypted"}, "catalog-service": {"$ref": "#/$defs/encrypted"}, "catalog-supplier-sync": {"$ref": "#/$defs/encrypted"}, "catalog-activation-worker": {"$ref": "#/$defs/encrypted"}, "pricing-service": {"$ref": "#/$defs/encrypted"}, "orders-service": {"$ref": "#/$defs/encrypted"}, "orders-aroma-preparation": {"$ref": "#/$defs/encrypted"}, "aroma-observer": {"$ref": "#/$defs/encrypted"}, "aroma-convergence": {"$ref": "#/$defs/encrypted"}, "aroma-gateway": {"$ref": "#/$defs/encrypted"}, "realtime-gateway": {"$ref": "#/$defs/encrypted"}
          }
        }
      }
    },
    "verificationKeyPair": {
      "type": "object", "additionalProperties": false, "required": ["active", "previous"],
      "properties": {"active": {"$ref": "#/$defs/encrypted"}, "previous": {"$ref": "#/$defs/encrypted"}}
    },
    "environment": {
      "type": "object", "additionalProperties": false, "required": ["bootstrap", "postgres", "kafka", "aroma", "edge", "security", "telemetry"],
      "properties": {
        "bootstrap": {"type": "object", "additionalProperties": false, "required": ["postgresAdminPassword", "internalCaPrivateKey"], "properties": {"postgresAdminPassword": {"$ref": "#/$defs/encrypted"}, "internalCaPrivateKey": {"$ref": "#/$defs/encrypted"}}},
        "postgres": {"$ref": "#/$defs/postgres"},
        "kafka": {"$ref": "#/$defs/kafka"},
        "aroma": {"type": "object", "additionalProperties": false, "required": ["email", "password", "sessionEncryptionKey", "catalogIdentityKeyV1"], "properties": {"email": {"$ref": "#/$defs/encrypted"}, "password": {"$ref": "#/$defs/encrypted"}, "sessionEncryptionKey": {"$ref": "#/$defs/encrypted"}, "catalogIdentityKeyV1": {"$ref": "#/$defs/encrypted"}}},
        "edge": {"type": "object", "additionalProperties": false, "required": ["tlsPrivateKey", "tlsCertificate", "oidcClientSecret"], "properties": {"tlsPrivateKey": {"$ref": "#/$defs/encrypted"}, "tlsCertificate": {"$ref": "#/$defs/encrypted"}, "tlsCaBundle": {"$ref": "#/$defs/encrypted"}, "oidcClientSecret": {"$ref": "#/$defs/encrypted"}}},
        "security": {"$ref": "#/$defs/security"},
        "telemetry": {"type": "object", "additionalProperties": false, "required": ["exporterToken"], "properties": {"exporterToken": {"$ref": "#/$defs/encrypted"}}}
      }
    },
    "sops": {
      "type": "object", "additionalProperties": false, "required": ["age", "lastmodified", "mac", "version", "unencrypted_regex"],
      "properties": {
        "age": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["recipient", "enc"], "properties": {"recipient": {"type": "string", "pattern": "^age1[0-9a-z]+$"}, "enc": {"type": "string", "minLength": 1}}}},
        "lastmodified": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "mac": {"$ref": "#/$defs/encrypted"},
        "version": {"type": "string", "const": "3.13.3"},
        "unencrypted_regex": {"type": "string", "const": "^(schemaVersion|username)$"}
      }
    }
  }
}
