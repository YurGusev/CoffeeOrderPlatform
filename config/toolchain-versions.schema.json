{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffee-platform.local/schemas/toolchain-versions.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "node",
    "npm",
    "corepack",
    "pnpm",
    "typescript",
    "typesNode",
    "fastify",
    "postgresql",
    "kafka",
    "confluentKafkaJavaScript",
    "librdkafka",
    "librdkafkaSourceSha256",
    "pg",
    "react",
    "reactDom",
    "reactRouterDom",
    "tanstackQuery",
    "vite",
    "vitest",
    "playwright",
    "openapi",
    "docker",
    "compose",
    "nodeImage",
    "kafkaImage",
    "fastifySwagger",
    "heyApiOpenapiTs",
    "spectralCli",
    "ajv",
    "pino",
    "opentelemetryApi",
    "scheduler",
    "opentelemetrySemanticConventions",
    "opentelemetryResources",
    "opentelemetrySdkMetrics",
    "opentelemetrySdkTraceBase",
    "opentelemetrySdkTraceNode",
    "opentelemetryApiLogs",
    "opentelemetrySdkLogs",
    "dependencyCruiser",
    "oxlint",
    "oxlintTsgolint",
    "prettier",
    "sops",
    "age",
    "effectTarget"
  ],
  "properties": {
    "$schema": { "const": "./toolchain-versions.schema.json" },
    "schemaVersion": { "type": "integer", "const": 2 },
    "node": { "$ref": "#/$defs/version" },
    "npm": { "$ref": "#/$defs/version" },
    "corepack": { "$ref": "#/$defs/version" },
    "pnpm": { "$ref": "#/$defs/version" },
    "typescript": { "$ref": "#/$defs/version" },
    "typesNode": { "$ref": "#/$defs/version" },
    "fastify": { "$ref": "#/$defs/version" },
    "postgresql": { "$ref": "#/$defs/version" },
    "pg": { "$ref": "#/$defs/version" },
    "kafka": { "$ref": "#/$defs/version" },
    "confluentKafkaJavaScript": { "$ref": "#/$defs/version" },
    "librdkafka": { "$ref": "#/$defs/version" },
    "librdkafkaSourceSha256": { "$ref": "#/$defs/digest" },
    "react": { "$ref": "#/$defs/version" },
    "reactDom": { "$ref": "#/$defs/version" },
    "reactRouterDom": { "$ref": "#/$defs/version" },
    "tanstackQuery": { "$ref": "#/$defs/version" },
    "vite": { "$ref": "#/$defs/version" },
    "vitest": { "$ref": "#/$defs/version" },
    "playwright": { "$ref": "#/$defs/version" },
    "openapi": { "$ref": "#/$defs/version" },
    "fastifySwagger": { "$ref": "#/$defs/version" },
    "heyApiOpenapiTs": { "$ref": "#/$defs/version" },
    "spectralCli": { "$ref": "#/$defs/version" },
    "ajv": { "$ref": "#/$defs/version" },
    "pino": { "$ref": "#/$defs/version" },
    "opentelemetryApi": { "$ref": "#/$defs/version" },
    "scheduler": { "$ref": "#/$defs/version" },
    "opentelemetrySemanticConventions": { "$ref": "#/$defs/version" },
    "opentelemetryResources": { "$ref": "#/$defs/version" },
    "opentelemetrySdkMetrics": { "$ref": "#/$defs/version" },
    "opentelemetrySdkTraceBase": { "$ref": "#/$defs/version" },
    "opentelemetrySdkTraceNode": { "$ref": "#/$defs/version" },
    "opentelemetryApiLogs": { "$ref": "#/$defs/version" },
    "opentelemetrySdkLogs": { "$ref": "#/$defs/version" },
    "dependencyCruiser": { "$ref": "#/$defs/version" },
    "oxlint": { "$ref": "#/$defs/version" },
    "oxlintTsgolint": { "$ref": "#/$defs/version" },
    "prettier": { "$ref": "#/$defs/version" },
    "sops": { "$ref": "#/$defs/version" },
    "age": { "$ref": "#/$defs/version" },
    "docker": { "$ref": "#/$defs/version" },
    "compose": { "$ref": "#/$defs/version" },
    "nodeImage": { "$ref": "#/$defs/image" },
    "kafkaImage": { "$ref": "#/$defs/image" },
    "effectTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityRef", "materializationOwner", "generatedOpenApi", "packages"],
      "properties": {
        "authorityRef": { "type": "string", "pattern": "^docs/adr/ADR-[0-9]{4}-[a-z0-9-]+\\.md$" },
        "materializationOwner": { "type": "string", "pattern": "^issue-[0-9]+$" },
        "generatedOpenApi": { "type": "string", "pattern": "^3\\.1\\.0$" },
        "packages": {
          "type": "object",
          "minProperties": 9,
          "additionalProperties": { "$ref": "#/$defs/version" },
          "propertyNames": { "pattern": "^(?:@effect/[a-z-]+|effect|pg-copy-streams)$" }
        }
      }
    }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)+(?:-[0-9A-Za-z.-]+)?$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "image": { "type": "string", "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$" }
  }
}
