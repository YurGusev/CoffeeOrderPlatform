{
  "$schema": "./node26-compatibility-matrix.schema.json",
  "schemaVersion": 2,
  "authorityRef": "docs/launch/09_EXISTING_DATABASE_AND_VERSIONS.md",
  "runtime": {
    "nodeRef": "config/toolchain-versions.json#/node",
    "platform": "linux",
    "architecture": "x64"
  },
  "components": [
    {
      "id": "fastify",
      "package": "fastify",
      "registryRef": "config/toolchain-versions.json#/fastify",
      "kind": "runtime",
      "probe": "fastify-factory",
      "required": true,
      "authoritative": true
    },
    {
      "id": "pg",
      "package": "pg",
      "registryRef": "config/toolchain-versions.json#/pg",
      "kind": "runtime",
      "probe": "pg-pool",
      "required": true,
      "authoritative": true
    },
    {
      "id": "confluent-kafka",
      "package": "@confluentinc/kafka-javascript",
      "registryRef": "config/toolchain-versions.json#/confluentKafkaJavaScript",
      "kind": "runtime-native",
      "probe": "confluent-kafka-native",
      "required": true,
      "authoritative": true
    },
    {
      "id": "opentelemetry-api",
      "package": "@opentelemetry/api",
      "registryRef": "config/toolchain-versions.json#/opentelemetryApi",
      "kind": "runtime",
      "probe": "opentelemetry-api",
      "required": true,
      "authoritative": true
    },
    {
      "id": "fastify-swagger",
      "package": "@fastify/swagger",
      "registryRef": "config/toolchain-versions.json#/fastifySwagger",
      "kind": "contract",
      "probe": "fastify-swagger-plugin",
      "required": true,
      "authoritative": true
    },
    {
      "id": "vitest",
      "package": "vitest",
      "registryRef": "config/toolchain-versions.json#/vitest",
      "kind": "test",
      "probe": "vitest-cli",
      "required": true,
      "authoritative": true
    },
    {
      "id": "playwright",
      "package": "playwright",
      "registryRef": "config/toolchain-versions.json#/playwright",
      "kind": "browser-test",
      "probe": "playwright-module",
      "required": true,
      "authoritative": true
    }
  ],
  "policy": {
    "exactPackageVersions": true,
    "nativeDependencyLoadRequired": true,
    "singleCompilerRef": "config/toolchain-versions.json#/typescript",
    "generatedContractSource": "effect-schema-httpapi",
    "generatedOpenApi": "3.1.0"
  }
}
