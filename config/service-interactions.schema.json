{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffeeorderplatform.local/schemas/service-interactions.v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "authority", "defaultPolicy", "databaseEdgesAcrossOwnersAllowed", "interactions"],
  "properties": {
    "$schema": {"const": "./service-interactions.schema.json"},
    "schemaVersion": {"const": 1},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["runtimeProfile", "contractCatalog", "eventCatalog"],
      "properties": {
        "runtimeProfile": {"const": "platform/launch-v1-runtime-profile.json"},
        "contractCatalog": {"const": "docs/launch/12_LAUNCH_CONTRACT_CATALOG.md"},
        "eventCatalog": {"const": "docs/launch/06_EVENTS_AND_RECOVERY.md"}
      }
    },
    "defaultPolicy": {"const": "deny"},
    "databaseEdgesAcrossOwnersAllowed": {"const": false},
    "interactions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/interaction"}}
  },
  "$defs": {
    "runtime": {"enum": ["edge-gateway", "api-public", "api-internal", "edge-nginx", "customer-service", "catalog-service", "catalog-supplier-sync", "catalog-activation-worker", "pricing-service", "orders-service", "orders-aroma-preparation", "aroma-observer", "aroma-convergence", "aroma-gateway", "realtime-gateway", "external:aroma-origin"]},
    "interaction": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "from", "to", "mode", "contract", "operations", "timeout", "retryOwner", "dataExposure"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "from": {"$ref": "#/$defs/runtime"}, "to": {"$ref": "#/$defs/runtime"},
        "mode": {"enum": ["http", "event", "provider-http"]},
        "contract": {"type": "string", "minLength": 1},
        "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "timeout": {"type": "string", "minLength": 1},
        "retryOwner": {"type": "string", "minLength": 1},
        "dataExposure": {"type": "string", "minLength": 1}
      }
    }
  }
}
