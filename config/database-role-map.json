{
  "$schema": "./database-role-map.schema.json",
  "schemaVersion": 2,
  "authorityRef": "docs/launch/05_DATA_OWNERSHIP.md",
  "databases": [
    {
      "name": "coffee_platform_customer",
      "schema": "customer",
      "migratorRole": "coffee_customer_migrator",
      "runtimeRoles": [
        {
          "runtime": "customer-service",
          "role": "coffee_customer_rw",
          "temporaryTables": true,
          "tables": {
            "customers": ["SELECT", "INSERT", "UPDATE"],
            "addresses": ["SELECT", "INSERT", "UPDATE"],
            "channel_links": ["SELECT", "INSERT", "UPDATE"],
            "idempotency_records": ["SELECT", "INSERT", "UPDATE"],
            "audit_log": ["SELECT", "INSERT"]
          }
        }
      ]
    },
    {
      "name": "coffee_platform_catalog",
      "schema": "catalog",
      "migratorRole": "coffee_catalog_migrator",
      "runtimeRoles": [
        {
          "runtime": "catalog-service",
          "role": "coffee_catalog_api_ro",
          "temporaryTables": true,
          "tables": {
            "active_products": ["SELECT"],
            "active_variants": ["SELECT"],
            "active_offer_mappings": ["SELECT"],
            "active_availability": ["SELECT"],
            "active_snapshot_metadata": ["SELECT"]
          }
        },
        {
          "runtime": "catalog-supplier-sync",
          "role": "coffee_catalog_import_rw",
          "temporaryTables": true,
          "tables": {
            "supplier_snapshots": ["SELECT", "INSERT", "UPDATE"],
            "snapshot_batches": ["SELECT", "INSERT"],
            "snapshot_products": ["SELECT", "INSERT"],
            "snapshot_variants": ["SELECT", "INSERT"],
            "snapshot_offers": ["SELECT", "INSERT"],
            "snapshot_availability": ["SELECT", "INSERT"]
          }
        },
        {
          "runtime": "catalog-activation-worker",
          "role": "coffee_catalog_activate_rw",
          "temporaryTables": true,
          "tables": {
            "supplier_snapshots": ["SELECT", "UPDATE"],
            "snapshot_batches": ["SELECT"],
            "snapshot_products": ["SELECT"],
            "snapshot_variants": ["SELECT"],
            "snapshot_offers": ["SELECT"],
            "snapshot_availability": ["SELECT"],
            "source_identities": ["SELECT", "INSERT", "UPDATE"],
            "catalog_state": ["SELECT", "INSERT", "UPDATE"],
            "products": ["SELECT", "INSERT"],
            "variants": ["SELECT", "INSERT"],
            "offer_mappings": ["SELECT", "INSERT"],
            "availability": ["SELECT", "INSERT"],
            "outbox_messages": ["SELECT", "INSERT", "UPDATE"],
            "offer_binding_acks": ["SELECT", "INSERT", "UPDATE"]
          },
          "columnUpdates": {
            "supplier_snapshots": [
              "state",
              "failure_code",
              "declared_batch_count",
              "declared_product_count",
              "declared_variant_count",
              "declared_offer_count",
              "content_hash",
              "received_at"
            ],
            "source_identities": ["last_seen_snapshot_ref", "state"]
          }
        }
      ]
    },
    {
      "name": "coffee_platform_pricing",
      "schema": "pricing",
      "migratorRole": "coffee_pricing_migrator",
      "runtimeRoles": [
        {
          "runtime": "pricing-service",
          "role": "coffee_pricing_rw",
          "temporaryTables": true,
          "tables": {
            "pricing_policy_versions": ["SELECT"],
            "pricing_quotes": ["SELECT", "INSERT"],
            "pricing_quote_lines": ["SELECT", "INSERT"],
            "pricing_idempotency_records": ["SELECT", "INSERT", "UPDATE"],
            "pricing_audit_records": ["SELECT", "INSERT"]
          }
        }
      ]
    },
    {
      "name": "coffee_platform_orders",
      "schema": "orders",
      "migratorRole": "coffee_orders_migrator",
      "runtimeRoles": [
        {
          "runtime": "orders-service",
          "role": "coffee_orders_service_rw",
          "temporaryTables": true,
          "tables": {
            "orders": ["SELECT", "INSERT", "UPDATE"],
            "order_items": ["SELECT", "INSERT", "UPDATE", "DELETE"],
            "order_history": ["SELECT", "INSERT"],
            "order_desired_contributions": ["SELECT", "INSERT"],
            "order_desired_contribution_lines": ["SELECT", "INSERT"],
            "idempotency_records": ["SELECT", "INSERT", "UPDATE"],
            "outbox_messages": ["SELECT", "INSERT", "UPDATE"],
            "order_aroma_projections": ["SELECT"]
          },
          "columnUpdates": {
            "orders": [
              "status",
              "version",
              "customer_ref",
              "customer_version",
              "customer_display_name",
              "customer_state",
              "customer_state_proof_hash",
              "currency",
              "confirmed_at",
              "updated_at",
              "last_modified_by_actor_ref"
            ]
          }
        },
        {
          "runtime": "orders-aroma-preparation",
          "role": "coffee_orders_prepare_rw",
          "temporaryTables": true,
          "tables": {
            "orders": ["SELECT"],
            "order_items": ["SELECT"],
            "order_desired_contributions": ["SELECT"],
            "order_desired_contribution_lines": ["SELECT"],
            "order_history": ["SELECT"],
            "order_aroma_projections": ["SELECT"],
            "cart_observed_revisions": ["SELECT"],
            "cart_observed_lines": ["SELECT"],
            "convergence_attempts": ["SELECT"],
            "convergence_leases": ["SELECT"],
            "mutation_reservations": ["SELECT"],
            "catalog_mapping_projection": ["SELECT", "INSERT", "UPDATE"],
            "cart_desired_revisions": ["SELECT", "INSERT", "UPDATE"],
            "inbox_messages": ["SELECT", "INSERT", "UPDATE"],
            "outbox_messages": ["SELECT", "INSERT", "UPDATE"],
            "cart_desired_lines": ["SELECT", "INSERT"],
            "cart_desired_blockers": ["SELECT", "INSERT"],
            "cart_desired_order_facts": ["SELECT", "INSERT"],
            "inbox_quarantine": ["SELECT", "INSERT"],
            "order_aroma_projection_history": ["SELECT", "INSERT"],
            "convergence_work": ["SELECT", "INSERT", "UPDATE"]
          }
        },
        {
          "runtime": "aroma-observer",
          "role": "coffee_orders_observer_rw",
          "temporaryTables": true,
          "tables": {
            "cart_desired_revisions": ["SELECT"],
            "cart_desired_lines": ["SELECT"],
            "cart_desired_order_facts": ["SELECT"],
            "order_aroma_projections": ["SELECT"],
            "cart_observed_revisions": ["SELECT", "INSERT", "UPDATE"],
            "inbox_messages": ["SELECT", "INSERT", "UPDATE"],
            "observation_schedule": ["SELECT", "INSERT", "UPDATE"],
            "outbox_messages": ["SELECT", "INSERT", "UPDATE"],
            "cart_observed_lines": ["SELECT", "INSERT"],
            "inbox_quarantine": ["SELECT", "INSERT"]
          }
        },
        {
          "runtime": "aroma-convergence",
          "role": "coffee_orders_convergence_rw",
          "temporaryTables": true,
          "tables": {
            "cart_desired_revisions": ["SELECT"],
            "cart_desired_lines": ["SELECT"],
            "cart_desired_blockers": ["SELECT"],
            "cart_desired_order_facts": ["SELECT"],
            "cart_observed_lines": ["SELECT", "INSERT"],
            "catalog_mapping_projection": ["SELECT"],
            "order_aroma_projections": ["SELECT"],
            "cart_observed_revisions": ["SELECT", "INSERT", "UPDATE"],
            "convergence_attempts": ["SELECT", "INSERT", "UPDATE"],
            "convergence_leases": ["SELECT", "INSERT", "UPDATE"],
            "inbox_messages": ["SELECT", "INSERT", "UPDATE"],
            "mutation_reservations": ["SELECT", "INSERT", "UPDATE"],
            "outbox_messages": ["SELECT", "INSERT", "UPDATE"],
            "inbox_quarantine": ["SELECT", "INSERT"],
            "convergence_work": ["SELECT", "UPDATE"]
          },
          "columnUpdates": {
            "convergence_work": ["dirty", "next_attempt_at", "updated_at"]
          }
        }
      ]
    },
    {
      "name": "coffee_platform_integration",
      "schema": "integration",
      "migratorRole": "coffee_integration_migrator",
      "runtimeRoles": [
        {
          "runtime": "aroma-gateway",
          "role": "coffee_aroma_gateway_rw",
          "temporaryTables": true,
          "tables": {
            "provider_sessions": ["SELECT", "INSERT", "UPDATE", "DELETE"],
            "provider_mutation_journal": [
              "SELECT",
              "INSERT",
              "UPDATE",
              "DELETE"
            ],
            "provider_catalog_exports": ["SELECT", "INSERT", "UPDATE"],
            "provider_export_batches": ["SELECT", "INSERT", "DELETE"],
            "provider_export_batch_offers": ["SELECT", "INSERT", "DELETE"],
            "provider_source_offers": ["SELECT", "INSERT"],
            "provider_export_offers": ["SELECT", "INSERT"],
            "provider_offer_bindings": ["SELECT", "INSERT"]
          }
        }
      ]
    }
  ]
}
