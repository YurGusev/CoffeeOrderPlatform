{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffeeorderplatform.local/schemas/service-catalog.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "authority",
    "exactRuntimeCount",
    "infrastructureSecretScopes",
    "runtimes",
    "newRuntimeProcedure"
  ],
  "properties": {
    "$schema": {
      "const": "./service-catalog.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeProfile", "runtimeCatalog", "contractCatalog"],
      "properties": {
        "runtimeProfile": {
          "const": "platform/launch-v1-runtime-profile.json"
        },
        "runtimeCatalog": {
          "const": "docs/launch/10_RUNTIME_CATALOG.md"
        },
        "contractCatalog": {
          "const": "docs/launch/12_LAUNCH_CONTRACT_CATALOG.md"
        }
      }
    },
    "exactRuntimeCount": {
      "const": 15
    },
    "infrastructureSecretScopes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "otel-collector",
        "grafana-bootstrap",
        "keycloak-runtime",
        "keycloak-operator",
        "kafka-broker"
      ],
      "properties": {
        "otel-collector": {
          "const": [
            { "name": "exporterToken", "ref": "telemetry.exporterToken" }
          ]
        },
        "grafana-bootstrap": {
          "const": [{ "name": "admin-secret", "ref": "telemetry.grafanaAdmin" }]
        },
        "keycloak-runtime": {
          "const": [
            { "name": "database-password", "ref": "identity.databasePassword" },
            {
              "name": "bootstrap-admin-password",
              "ref": "identity.bootstrapAdminPassword"
            },
            { "name": "tls-key", "ref": "identity.tlsPrivateKey" },
            { "name": "tls-cert", "ref": "identity.tlsCertificate" },
            { "name": "tls-ca", "ref": "identity.tlsCaBundle" }
          ]
        },
        "keycloak-operator": {
          "const": [
            { "name": "operator-password", "ref": "identity.operatorPassword" }
          ]
        },
        "kafka-broker": {
          "const": [
            { "name": "broker-user", "ref": "kafka.broker.username" },
            { "name": "broker-password", "ref": "kafka.broker.password" },
            { "name": "store-password", "ref": "kafka.broker.storePassword" },
            { "name": "tls-key", "ref": "kafka.broker.tlsPrivateKey" },
            { "name": "tls-cert", "ref": "kafka.broker.tlsCertificate" },
            { "name": "tls-ca", "ref": "kafka.broker.tlsCaBundle" },
            { "name": "catalog-user", "ref": "kafka.catalog.username" },
            { "name": "catalog-password", "ref": "kafka.catalog.password" },
            { "name": "catalog-ca", "ref": "kafka.catalog.caPem" },
            { "name": "orders-user", "ref": "kafka.orders.username" },
            { "name": "orders-password", "ref": "kafka.orders.password" },
            { "name": "orders-ca", "ref": "kafka.orders.caPem" },
            { "name": "realtime-user", "ref": "kafka.realtime.username" },
            { "name": "realtime-password", "ref": "kafka.realtime.password" },
            { "name": "realtime-ca", "ref": "kafka.realtime.caPem" }
          ]
        }
      }
    },
    "runtimes": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "$ref": "#/$defs/runtime"
      }
    },
    "newRuntimeProcedure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "automaticCatalogExtensionAllowed"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "automaticCatalogExtensionAllowed": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "runtimeName": {
      "enum": [
        "edge-gateway",
        "api-public",
        "api-internal",
        "edge-nginx",
        "customer-service",
        "catalog-service",
        "catalog-supplier-sync",
        "catalog-activation-worker",
        "pricing-service",
        "orders-service",
        "orders-aroma-preparation",
        "aroma-observer",
        "aroma-convergence",
        "aroma-gateway",
        "realtime-gateway"
      ]
    },
    "database": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["name", "role", "access"],
      "properties": {
        "name": {
          "enum": [
            "coffee_platform_customer",
            "coffee_platform_catalog",
            "coffee_platform_pricing",
            "coffee_platform_orders",
            "coffee_platform_integration"
          ]
        },
        "role": {
          "type": "string",
          "pattern": "^coffee_[a-z0-9_]+$"
        },
        "access": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "owner",
        "sourceRoot",
        "purpose",
        "contractPackages",
        "incomingHttp",
        "incomingEvents",
        "schedules",
        "outgoingHttp",
        "outgoingEvents",
        "database",
        "secretRefs",
        "publicity",
        "transportMode"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/runtimeName"
        },
        "owner": {
          "enum": [
            "platform",
            "frontend",
            "customer",
            "catalog",
            "pricing",
            "orders",
            "integration",
            "realtime"
          ]
        },
        "sourceRoot": {
          "type": "string",
          "pattern": "^apps/[a-z0-9-]+$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "contractPackages": {
          "$ref": "#/$defs/stringArray"
        },
        "incomingHttp": {
          "$ref": "#/$defs/stringArray"
        },
        "incomingEvents": {
          "$ref": "#/$defs/stringArray"
        },
        "schedules": {
          "$ref": "#/$defs/stringArray"
        },
        "outgoingHttp": {
          "$ref": "#/$defs/stringArray"
        },
        "outgoingEvents": {
          "$ref": "#/$defs/stringArray"
        },
        "database": {
          "$ref": "#/$defs/database"
        },
        "secretRefs": {
          "$ref": "#/$defs/stringArray"
        },
        "optionalSecretRefs": {
          "$ref": "#/$defs/stringArray"
        },
        "publicity": {
          "enum": [
            "public-ingress",
            "private-trust-root",
            "private-edge-backend",
            "private-owner-backend",
            "private-worker",
            "private-mutation-worker",
            "private-provider-gateway",
            "edge-only-realtime"
          ]
        },
        "transportMode": {
          "enum": ["public-tls", "mtls"]
        },
        "runtimeKind": {
          "const": "native-nginx"
        }
      }
    }
  }
}
