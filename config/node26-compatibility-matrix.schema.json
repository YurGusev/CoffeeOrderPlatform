{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffee-platform.invalid/schemas/node26-compatibility-matrix.schema.json",
  "title": "CoffeeOrderPlatform Node compatibility projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "authorityRef", "runtime", "components", "policy"],
  "properties": {
    "$schema": {"const": "./node26-compatibility-matrix.schema.json"},
    "schemaVersion": {"const": 2},
    "authorityRef": {"type": "string", "pattern": "^docs/launch/[0-9]{2}_[A-Z0-9_]+\\.md$"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/component"}},
    "policy": {"$ref": "#/$defs/policy"}
  },
  "$defs": {
    "registryRef": {"type": "string", "pattern": "^config/toolchain-versions\\.json#/[A-Za-z][A-Za-z0-9]*$"},
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["nodeRef", "platform", "architecture"],
      "properties": {
        "nodeRef": {"$ref": "#/$defs/registryRef"},
        "platform": {"const": "linux"},
        "architecture": {"const": "x64"}
      }
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "package", "registryRef", "kind", "probe", "required", "authoritative"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "package": {"type": "string", "minLength": 1},
        "registryRef": {"$ref": "#/$defs/registryRef"},
        "kind": {"type": "string", "enum": ["runtime", "runtime-native", "contract", "test", "browser-test"]},
        "probe": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "authoritative": {"type": "boolean"}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["exactPackageVersions", "nativeDependencyLoadRequired", "singleCompilerRef", "generatedContractSource", "generatedOpenApi"],
      "properties": {
        "exactPackageVersions": {"const": true},
        "nativeDependencyLoadRequired": {"const": true},
        "singleCompilerRef": {"$ref": "#/$defs/registryRef"},
        "generatedContractSource": {"const": "effect-schema-httpapi"},
        "generatedOpenApi": {"type": "string", "pattern": "^3\\.1\\.0$"}
      }
    }
  }
}
