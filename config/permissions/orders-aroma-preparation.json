{
  "schemaVersion": 1,
  "runtime": "orders-aroma-preparation",
  "allowNet": ["coffee_postgres:5432", "kafka:9092"],
  "allowFsRead": [
    "/app/config/platform.yaml",
    "/app/apps",
    "/app/dist",
    "/app/node_modules",
    "/app/packages",
    "/app/package.json",
    "/run/secrets/coffee-platform.yaml",
    "/run/coffee-launch/context.json",
    "/app/config/database-ownership.json"
  ],
  "allowFsWrite": [],
  "allowChildProcess": false,
  "allowWorker": false,
  "allowAddons": true,
  "allowFfi": false
}
