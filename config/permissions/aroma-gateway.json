{
  "schemaVersion": 1,
  "runtime": "aroma-gateway",
  "allowNet": ["coffee_postgres:5432", "${aroma.origin.host}:443"],
  "allowFsRead": [
    "/app/config/platform.yaml",
    "/app/apps",
    "/app/dist",
    "/app/node_modules",
    "/app/packages",
    "/app/package.json",
    "/run/secrets/coffee-platform.yaml"
  ],
  "allowFsWrite": [],
  "allowChildProcess": false,
  "allowWorker": false,
  "allowAddons": false,
  "allowFfi": false
}
