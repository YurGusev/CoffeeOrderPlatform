{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffee-platform.invalid/schemas/platform.schema.json",
  "title": "CoffeeOrderPlatform launch configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "environment", "toolchainRef", "platform", "postgres", "kafka", "aroma", "pricingPolicy", "security", "nginxTransport", "services"],
  "properties": {
    "$schema": {"type": "string", "const": "./platform.schema.json"},
    "schemaVersion": {"type": "integer", "const": 1},
    "environment": {"type": "string", "enum": ["development", "staging", "production"]},
    "toolchainRef": {"type": "string", "const": "config/toolchain-versions.json"},
    "platform": {"$ref": "#/$defs/platform"},
    "postgres": {"$ref": "#/$defs/postgres"},
    "kafka": {"$ref": "#/$defs/kafka"},
    "aroma": {"$ref": "#/$defs/aroma"},
    "pricingPolicy": {"$ref": "#/$defs/pricingPolicy"},
    "security": {"$ref": "#/$defs/security"},
    "nginxTransport": {"$ref": "./nginx-profile.schema.json"},
    "browserOidc": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/browserOidcProfile"}]},
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge-gateway", "api-public", "api-internal", "customer-service",
        "catalog-service", "catalog-supplier-sync", "catalog-activation-worker",
        "pricing-service", "orders-service", "orders-aroma-preparation",
        "aroma-observer", "aroma-convergence", "aroma-gateway", "realtime-gateway"
      ],
      "properties": {
        "edge-gateway": {"$ref": "#/$defs/service"},
        "api-public": {"$ref": "#/$defs/service"},
        "api-internal": {"$ref": "#/$defs/service"},
        "customer-service": {"$ref": "#/$defs/service"},
        "catalog-service": {"$ref": "#/$defs/service"},
        "catalog-supplier-sync": {"$ref": "#/$defs/service"},
        "catalog-activation-worker": {"$ref": "#/$defs/service"},
        "pricing-service": {"$ref": "#/$defs/service"},
        "orders-service": {"$ref": "#/$defs/service"},
        "orders-aroma-preparation": {"type": "object", "allOf": [{"$ref": "#/$defs/service"}, {"required": ["aromaPreparation"], "properties": {"aromaPreparation": {"$ref": "#/$defs/aromaPreparation"}}}]},
        "aroma-observer": {"type": "object", "allOf": [{"$ref": "#/$defs/service"}, {"required": ["aromaObservation"], "properties": {"aromaObservation": {"$ref": "#/$defs/aromaObservation"}}}]},
        "aroma-convergence": {"type": "object", "allOf": [{"$ref": "#/$defs/service"}, {"required": ["mutationsEnabled", "aromaConvergence"], "properties": {"mutationsEnabled": {"type": "boolean"}, "aromaConvergence": {"$ref": "#/$defs/aromaConvergence"}}}]},
        "aroma-gateway": {"$ref": "#/$defs/service"},
        "realtime-gateway": {"$ref": "#/$defs/service"}
      },
      "allOf": [{"properties": {
        "edge-gateway": {"$ref": "#/$defs/noAromaWorkflow"},
        "api-public": {"$ref": "#/$defs/noAromaWorkflow"},
        "api-internal": {"$ref": "#/$defs/noAromaWorkflow"},
        "customer-service": {"$ref": "#/$defs/noAromaWorkflow"},
        "catalog-service": {"$ref": "#/$defs/noAromaWorkflow"},
        "catalog-supplier-sync": {"$ref": "#/$defs/noAromaWorkflow"},
        "catalog-activation-worker": {"$ref": "#/$defs/noAromaWorkflow"},
        "pricing-service": {"$ref": "#/$defs/noAromaWorkflow"},
        "orders-service": {"$ref": "#/$defs/noAromaWorkflow"},
        "orders-aroma-preparation": {"type": "object", "properties": {"mutationsEnabled": false, "aromaObservation": false, "aromaConvergence": false}},
        "aroma-observer": {"type": "object", "properties": {"mutationsEnabled": false, "aromaPreparation": false, "aromaConvergence": false}},
        "aroma-convergence": {"type": "object", "properties": {"aromaPreparation": false, "aromaObservation": false}},
        "aroma-gateway": {"$ref": "#/$defs/noAromaWorkflow"},
        "realtime-gateway": {"$ref": "#/$defs/noAromaWorkflow"}
      }}]
    }
  },
  "$defs": {
    "noAromaWorkflow": {"type": "object", "properties": {"mutationsEnabled": false, "aromaPreparation": false, "aromaObservation": false, "aromaConvergence": false}},
    "aromaPreparation": {
      "type": "object", "additionalProperties": false,
      "required": ["pollIntervalMs", "batchSize", "maxOrders", "maxLines"],
      "properties": {
        "pollIntervalMs": {"type": "integer", "minimum": 1, "maximum": 300000},
        "batchSize": {"type": "integer", "minimum": 1, "maximum": 1000},
        "maxOrders": {"type": "integer", "minimum": 1, "maximum": 10000},
        "maxLines": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "aromaObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["pollIntervalMs", "intervalMs", "leaseMs", "maxSnapshotAgeMs", "maxLines", "maxResponseBytes"],
      "properties": {
        "pollIntervalMs": {"type": "integer", "minimum": 1, "maximum": 300000},
        "intervalMs": {"type": "integer", "minimum": 1, "maximum": 300000},
        "leaseMs": {"type": "integer", "minimum": 1, "maximum": 300000},
        "maxSnapshotAgeMs": {"type": "integer", "minimum": 1, "maximum": 300000},
        "maxLines": {"type": "integer", "minimum": 1, "maximum": 10000},
        "maxResponseBytes": {"type": "integer", "const": 2097152}
      }
    },
    "aromaConvergence": {
      "type": "object", "additionalProperties": false,
      "required": ["pollIntervalMs", "leaseMs", "heartbeatIntervalMs", "providerDeadlineMs", "safetyMarginMs", "retryBackoffMs", "maxSnapshotAgeMs", "maxLines", "maxResponseBytes"],
      "properties": {
        "pollIntervalMs": {"type": "integer", "minimum": 1, "maximum": 300000},
        "leaseMs": {"type": "integer", "const": 30000},
        "heartbeatIntervalMs": {"type": "integer", "const": 10000},
        "providerDeadlineMs": {"type": "integer", "minimum": 1, "maximum": 300000},
        "safetyMarginMs": {"type": "integer", "minimum": 1, "maximum": 300000},
        "retryBackoffMs": {"type": "integer", "minimum": 1, "maximum": 300000},
        "maxSnapshotAgeMs": {"type": "integer", "minimum": 1, "maximum": 300000},
        "maxLines": {"type": "integer", "minimum": 1, "maximum": 10000},
        "maxResponseBytes": {"type": "integer", "const": 2097152}
      }
    },
    "pricingPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["policyVersionRef", "version", "currency", "markupBasisPoints", "minimumMarginMinor", "quoteTtlSeconds", "quantityScale", "roundingMode"],
      "properties": {
        "policyVersionRef": {"type": "string", "pattern": "^pvr_[0-9A-HJKMNP-TV-Z]{26}$"},
        "version": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "currency": {"const": "RUB"},
        "markupBasisPoints": {"type": "integer", "minimum": 0, "maximum": 100000},
        "minimumMarginMinor": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
        "quoteTtlSeconds": {"type": "integer", "minimum": 60, "maximum": 3600},
        "quantityScale": {"const": 3},
        "roundingMode": {"const": "CEILING"}
      }
    },
    "positiveInteger": {"type": "integer", "minimum": 1},
    "nonNegativeInteger": {"type": "integer", "minimum": 0},
    "browserOidcProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "clientId", "authorizationUrl", "tokenUrl", "jwksUrl", "redirectUri", "allowedAlgorithms", "actorRefClaim", "permissionsClaim"],
      "properties": {
        "issuer": {"type": "string", "minLength": 1},
        "clientId": {"type": "string", "minLength": 1},
        "authorizationUrl": {"type": "string", "minLength": 1},
        "tokenUrl": {"type": "string", "minLength": 1},
        "jwksUrl": {"type": "string", "minLength": 1},
        "redirectUri": {"type": "string", "minLength": 1},
        "allowedAlgorithms": {"const": ["RS256"]},
        "actorRefClaim": {"type": "string", "minLength": 1},
        "permissionsClaim": {"type": "string", "minLength": 1}
      }
    },
    "stringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["livePath", "readyPath", "metricsPath", "intervalMs", "timeoutMs", "startupGraceMs", "failureThreshold", "successThreshold"],
      "properties": {
        "livePath": {"type": "string", "const": "/health/live"},
        "readyPath": {"type": "string", "const": "/health/ready"},
        "metricsPath": {"type": "string", "const": "/metrics"},
        "intervalMs": {"type": "integer", "const": 5000},
        "timeoutMs": {"type": "integer", "const": 1000},
        "startupGraceMs": {"type": "integer", "const": 30000},
        "failureThreshold": {"type": "integer", "const": 3},
        "successThreshold": {"type": "integer", "const": 1}
      }
    },
    "dbPool": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["max", "checkoutTimeoutMs", "lockTimeoutMs", "interactiveStatementTimeoutMs", "backgroundStatementTimeoutMs", "terminalTimeoutMs", "transactionTimeoutMs", "idleTimeoutMs", "maxLifetimeMs"],
      "properties": {
        "max": { "type": "integer", "minimum": 0, "maximum": 64 },
        "checkoutTimeoutMs": { "type": "integer", "const": 250 },
        "lockTimeoutMs": { "type": "integer", "const": 250 },
        "interactiveStatementTimeoutMs": { "type": "integer", "const": 1500 },
        "backgroundStatementTimeoutMs": { "type": "integer", "const": 5000 },
        "terminalTimeoutMs": { "type": "integer", "const": 2000 },
        "transactionTimeoutMs": { "type": "integer", "const": 10000 },
        "idleTimeoutMs": { "type": "integer", "const": 30000 },
        "maxLifetimeMs": { "type": "integer", "const": 1800000 }
      }
    },
    "kafkaConsumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groupId", "topics", "processing"],
      "properties": {
        "groupId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "topics": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "minItems": 1
        },
        "processing": { "type": "string", "enum": ["durable", "realtime"] }
      }
    },
    "kafkaAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producers", "consumers"],
      "properties": {
        "producers": { "$ref": "#/$defs/stringArray" },
        "consumers": {
          "type": "array",
          "items": { "$ref": "#/$defs/kafkaConsumer" }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "net", "fsRead", "fsWrite", "childProcess", "workers"],
      "properties": {
        "manifest": {"type": "string", "pattern": "^config/permissions/[a-z0-9-]+\\.json$"},
        "net": {"$ref": "#/$defs/stringArray"},
        "fsRead": {"$ref": "#/$defs/stringArray"},
        "fsWrite": {"$ref": "#/$defs/stringArray"},
        "childProcess": {"type": "boolean", "const": false},
        "workers": {"type": "boolean", "const": false}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transportMode", "listen", "health", "deadlineMs", "deadlineProfiles", "concurrency", "replicas", "dbPool", "database", "kafka", "outbound", "secretRefs", "permissions", "mutationCapability"],
      "properties": {
        "transportMode": { "type": "string", "enum": ["public-tls", "mtls"] },
        "listen": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "port"],
          "properties": {
            "host": { "type": "string", "const": "0.0.0.0" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "health": { "$ref": "#/$defs/health" },
        "deadlineMs": { "type": ["integer", "null"], "minimum": 1 },
        "scheduler": {
          "type": "object",
          "additionalProperties": false,
          "required": ["intervalMs", "startupImport", "overlapPolicy"],
          "properties": {
            "intervalMs": {"type": "integer", "const": 3600000},
            "startupImport": {"type": "boolean", "const": true},
            "overlapPolicy": {"type": "string", "const": "skip"}
          }
        },
        "deadlineProfiles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["defaultMs"],
          "properties": {
            "defaultMs": { "type": ["integer", "null"], "minimum": 1 },
            "readMs": { "type": "integer", "minimum": 1 },
            "cartMs": { "type": "integer", "minimum": 1 },
            "mutationMs": { "type": "integer", "minimum": 1 }
          }
        },
        "concurrency": { "type": "integer", "minimum": 1 },
        "replicas": { "type": "integer", "minimum": 1 },
        "dbPool": { "$ref": "#/$defs/dbPool" },
        "database": {
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "kafka": { "$ref": "#/$defs/kafkaAccess" },
        "outbound": { "$ref": "#/$defs/stringArray" },
        "secretRefs": {
          "type": "array", "uniqueItems": true, "minItems": 0,
          "items": {"type": "string", "pattern": "^[a-z][a-zA-Z0-9-]*(\\.[a-z][a-zA-Z0-9-]*)+$"}
        },
        "optionalSecretRefs": {
          "type": "array", "uniqueItems": true, "minItems": 0,
          "items": {"type": "string", "pattern": "^[a-z][a-zA-Z0-9-]*(\\.[a-z][a-zA-Z0-9-]*)+$"}
        },
        "permissions": {"$ref": "#/$defs/permissions"},
        "mutationCapability": {"type": "boolean"},
        "catalogSnapshotProof": {
          "type": "object", "additionalProperties": false,
          "required": ["maxAgeMs"],
          "properties": {"maxAgeMs": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}}
        },
        "mutationsEnabled": {"type": "boolean"},
        "aromaPreparation": {"$ref": "#/$defs/aromaPreparation"},
        "aromaObservation": {"$ref": "#/$defs/aromaObservation"},
        "aromaConvergence": {"$ref": "#/$defs/aromaConvergence"}
      }
    },
    "platform": {
      "type": "object", "additionalProperties": false,
      "required": ["publicBaseUrl", "shutdownGraceMs", "requestDeadlineMs", "bodyLimitBytes", "health", "outbox"],
      "properties": {
        "publicBaseUrl": {"type": "string", "pattern": "^https://[^\\s]+$"},
        "shutdownGraceMs": {"type": "integer", "const": 30000},
        "requestDeadlineMs": {"type": "integer", "const": 5000},
        "bodyLimitBytes": {"type": "integer", "const": 1048576},
        "health": {"$ref": "#/$defs/health"},
        "outbox": {
          "type": "object", "additionalProperties": false,
          "required": ["pollIntervalMs", "batchSize", "claimLeaseMs", "maxAttempts", "backoffMs", "publishedRetentionHours", "failedRetentionHours", "invalidSchemaAction"],
          "properties": {
            "pollIntervalMs": {"type": "integer", "const": 250},
            "batchSize": {"type": "integer", "const": 100},
            "claimLeaseMs": {"type": "integer", "const": 30000},
            "maxAttempts": {"type": "integer", "const": 12},
            "backoffMs": {"type": "array", "const": [1000, 5000, 30000, 60000]},
            "publishedRetentionHours": {"type": "integer", "const": 168},
            "failedRetentionHours": {"type": "integer", "const": 720},
            "invalidSchemaAction": {"type": "string", "const": "quarantine"}
          }
        }
      }
    },
    "postgres": {
      "type": "object", "additionalProperties": false,
      "required": ["host", "port", "sslMode", "maxConnections", "reservedConnections", "rolloutReplicas"],
      "properties": {
        "host": {"type": "string", "const": "coffee_postgres"},
        "port": {"type": "integer", "const": 5432},
        "sslMode": {"type": "string", "enum": ["prefer", "require", "verify-full"]},
        "maxConnections": {"type": "integer", "minimum": 96},
        "reservedConnections": {"type": "integer", "const": 32},
        "rolloutReplicas": {"type": "integer", "const": 1}
      }
    },
    "kafka": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brokers",
        "clientProtocol",
        "autoTopicCreation",
        "topics",
        "delivery"
      ],
      "properties": {
        "brokers": {"type": "array", "const": ["kafka:9092"]},
        "clientProtocol": {"type": "string", "const": "SASL_SSL"},
        "autoTopicCreation": {"type": "boolean", "const": false},
        "topics": {
          "type": "object", "additionalProperties": false,
          "required": ["catalogSnapshot", "catalogMapping", "ordersLifecycle", "aromaCommands", "aromaEvents", "realtimeInvalidate"],
          "properties": {
            "catalogSnapshot": { "$ref": "#/$defs/topic" },
            "catalogMapping": { "$ref": "#/$defs/topic" },
            "ordersLifecycle": { "$ref": "#/$defs/topic" },
            "aromaCommands": { "$ref": "#/$defs/topic" },
            "aromaEvents": { "$ref": "#/$defs/topic" },
            "realtimeInvalidate": { "$ref": "#/$defs/topic" }
          }
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "producerRetries",
            "maxMessageBytes",
            "maxPartitions",
            "maxInFlight",
            "queueCapacity",
            "sendTimeoutMs",
            "receiveTimeoutMs",
            "commitTimeoutMs",
            "revokeTimeoutMs",
            "shutdownTimeoutMs",
            "leaseMs",
            "retry",
            "quarantine"
          ],
          "properties": {
            "producerRetries": { "type": "integer", "const": 3 },
            "maxMessageBytes": { "type": "integer", "const": 1048576 },
            "maxPartitions": { "type": "integer", "const": 24 },
            "maxInFlight": { "type": "integer", "const": 4 },
            "queueCapacity": { "type": "integer", "const": 32 },
            "sendTimeoutMs": { "type": "integer", "const": 2000 },
            "receiveTimeoutMs": { "type": "integer", "const": 1000 },
            "commitTimeoutMs": { "type": "integer", "const": 2000 },
            "revokeTimeoutMs": { "type": "integer", "const": 2000 },
            "shutdownTimeoutMs": { "type": "integer", "const": 5000 },
            "leaseMs": { "type": "integer", "const": 30000 },
            "retry": {
              "type": "object",
              "additionalProperties": false,
              "required": ["baseMs", "maxMs", "maxAttempts"],
              "properties": {
                "baseMs": { "type": "integer", "const": 1000 },
                "maxMs": { "type": "integer", "const": 60000 },
                "maxAttempts": { "type": "integer", "const": 12 }
              }
            },
            "quarantine": {
              "type": "object",
              "additionalProperties": false,
              "required": ["durable", "realtime"],
              "properties": {
                "durable": { "type": "string", "const": "owner-database" },
                "realtime": { "type": "string", "const": "topic-dlq" }
              }
            }
          }
        }
      }
    },
    "topic": {
      "type": "object", "additionalProperties": false, "required": ["name", "partitions", "retentionHours", "dlq"],
      "properties": {
        "name": {"type": "string", "pattern": "^coffee\\.[a-z.]+\\.v[0-9]+$"},
        "partitions": {"type": "integer", "minimum": 1},
        "retentionHours": {"type": "integer", "minimum": 1},
        "dlq": {"type": "string", "pattern": "^coffee\\.[a-z.]+\\.v[0-9]+\\.dlq$"}
      }
    },
    "aroma": {
      "type": "object", "additionalProperties": false, "required": ["supplierRef", "scopeRef", "origin", "redirectsAllowed", "defaultPacking"],
      "properties": {
        "supplierRef": {"type": "string", "const": "sup_00000000000000000000000001"},
        "scopeRef": {"type": "string", "const": "aroma-primary"},
        "origin": {
          "type": "object", "additionalProperties": false, "required": ["scheme", "host", "port"],
          "properties": {"scheme": {"type": "string", "const": "https"}, "host": {"type": "string", "const": "aromateacoffee.ru"}, "port": {"type": "integer", "const": 443}}
        },
        "redirectsAllowed": {"type": "boolean", "const": false},
        "defaultPacking": {"type": "string", "const": "Aroma"}
      }
    },
    "security": {
      "type": "object", "additionalProperties": false, "required": ["actorContext", "catalogCursor", "customerCursor", "serviceTrustBundles", "delegation"],
      "properties": {
        "actorContext": {"$ref": "#/$defs/signingPolicy"},
        "catalogCursor": {"$ref": "#/$defs/signingPolicy"},
        "customerCursor": {"allOf": [{"$ref": "#/$defs/signingPolicy"}, {"type": "object", "required": ["previousKeyTrustUntilEpochSeconds"]}]},
        "serviceTrustBundles": {
          "type": "object", "additionalProperties": false, "required": ["activeKid", "previousKid", "overlapHours", "publicKeys"],
          "properties": {
            "activeKid": {"type": "string", "const": "transport-v1"},
            "previousKid": {"type": "string", "const": "transport-v0"},
            "overlapHours": {"type": "integer", "const": 12},
            "publicKeys": {
              "type": "object", "additionalProperties": false, "required": [
                "edge-gateway", "api-public", "api-internal", "edge-nginx", "customer-service", "catalog-service",
                "catalog-supplier-sync", "catalog-activation-worker", "pricing-service", "orders-service",
                "orders-aroma-preparation", "aroma-observer", "aroma-convergence", "aroma-gateway", "realtime-gateway"
              ],
              "properties": {
                "edge-gateway": {"$ref": "#/$defs/publicKeyPair"}, "api-public": {"$ref": "#/$defs/publicKeyPair"}, "api-internal": {"$ref": "#/$defs/publicKeyPair"}, "edge-nginx": {"$ref": "#/$defs/publicKeyPair"}, "customer-service": {"$ref": "#/$defs/publicKeyPair"}, "catalog-service": {"$ref": "#/$defs/publicKeyPair"}, "catalog-supplier-sync": {"$ref": "#/$defs/publicKeyPair"}, "catalog-activation-worker": {"$ref": "#/$defs/publicKeyPair"}, "pricing-service": {"$ref": "#/$defs/publicKeyPair"}, "orders-service": {"$ref": "#/$defs/publicKeyPair"}, "orders-aroma-preparation": {"$ref": "#/$defs/publicKeyPair"}, "aroma-observer": {"$ref": "#/$defs/publicKeyPair"}, "aroma-convergence": {"$ref": "#/$defs/publicKeyPair"}, "aroma-gateway": {"$ref": "#/$defs/publicKeyPair"}, "realtime-gateway": {"$ref": "#/$defs/publicKeyPair"}
              }
            }
          }
        },
        "delegation": {
          "type": "object", "additionalProperties": false, "required": ["publicActor", "internalService"],
          "properties": {
            "publicActor": {"type": "object", "additionalProperties": false, "required": ["issuer", "audience", "maxTtlSeconds", "clockSkewSeconds"], "properties": {"issuer": {"type": "string", "const": "api-public"}, "audience": {"type": "string", "const": "owner-service"}, "maxTtlSeconds": {"type": "integer", "const": 60}, "clockSkewSeconds": {"type": "integer", "const": 5}}},
            "internalService": {"type": "object", "additionalProperties": false, "required": ["issuer", "maxTtlRule", "gatewayMutationCaller"], "properties": {"issuer": {"type": "string", "const": "api-internal"}, "maxTtlRule": {"type": "string", "const": "remaining-request-deadline-plus-5s-skew"}, "gatewayMutationCaller": {"type": "string", "const": "aroma-convergence"}}}
          }
        }
      }
    },
    "signingPolicy": {
      "type": "object", "additionalProperties": false, "required": ["algorithm", "activeKid", "previousKid", "maxAgeSeconds", "clockSkewSeconds", "overlapSeconds", "verificationKeys"],
      "properties": {
        "algorithm": {"type": "string", "const": "Ed25519"},
        "activeKid": {"type": "string", "minLength": 1},
        "previousKid": {"type": "string", "minLength": 1},
        "maxAgeSeconds": {"type": "integer", "minimum": 1},
        "clockSkewSeconds": {"type": "integer", "minimum": 0},
        "overlapSeconds": {"type": "integer", "minimum": 1},
        "previousKeyTrustUntilEpochSeconds": {"type": "integer", "minimum": 0},
        "verificationKeys": {"type": "object", "additionalProperties": false, "minProperties": 2, "patternProperties": {"^[a-zA-Z0-9-]+$": {"type": "string", "minLength": 1}}}
      }
    },
    "publicKeyPair": {
      "type": "object", "additionalProperties": false, "required": ["active", "previous"],
      "properties": {"active": {"type": "string", "minLength": 1}, "previous": {"type": "string", "minLength": 1}}
    }
  }
}
