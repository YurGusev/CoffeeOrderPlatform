{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffeeorderplatform.local/contracts/schemas/common/money-version-time.v1.schema.json",
  "title": "CoffeeOrderPlatform common money, quantity and time v1",
  "$defs": {
    "MoneyMinor": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)$"
    },
    "Revision": { "$ref": "identifiers.v1.schema.json#/$defs/Version" },
    "QuantityDecimal": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,5})(?:\\.[0-9]{1,3})?$|^0\\.(?!0{1,3}$)[0-9]{1,3}$"
    },
    "QuantityMilli": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "ProviderQuantity": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*)(?:\\.[0-9]+)?$|^0\\.(?!0+$)[0-9]+$"
    },
    "HashSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Hash": { "$ref": "#/$defs/HashSha256" },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "Currency": { "type": "string", "const": "RUB" },
    "Traceparent": {
      "allOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
        },
        { "not": { "type": "string", "pattern": "^ff-" } },
        { "not": { "type": "string", "pattern": "^[0-9a-f]{2}-0{32}-" } },
        {
          "not": {
            "type": "string",
            "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-0{16}-"
          }
        }
      ]
    }
  }
}
