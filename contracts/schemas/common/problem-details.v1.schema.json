{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffeeorderplatform.local/contracts/schemas/common/problem-details.v1.schema.json",
  "title": "CoffeeOrderPlatform RFC 9457 Problem Details v1",
  "$defs": {
    "ProblemError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "field": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "ProblemDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "status",
        "code",
        "detail",
        "instance",
        "correlationId",
        "errors"
      ],
      "properties": {
        "type": { "type": "string", "format": "uri-reference", "minLength": 1, "maxLength": 2048 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "status": { "type": "integer", "minimum": 400, "maximum": 599 },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
        "detail": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "instance": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "correlationId": {
          "$ref": "identifiers.v1.schema.json#/$defs/Uuid"
        },
        "errors": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/ProblemError" }
        }
      }
    }
  }
}
