{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffeeorderplatform.local/contracts/schemas/events/order-confirmed.v1.schema.json",
  "title": "OrderConfirmed.v1",
  "allOf": [
    { "$ref": "../common/message-envelope.v1.schema.json#/$defs/MessageEnvelope" },
    {
      "type": "object",
      "required": ["messageType", "payload"],
      "properties": {
        "messageType": { "const": "OrderConfirmed.v1" },
        "producer": { "const": "orders-service" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["orderRef", "orderVersion", "customerRef", "confirmedAt", "contributionRevision"],
          "properties": {
            "orderRef": { "$ref": "../common/identifiers.v1.schema.json#/$defs/OrderRef" },
            "orderVersion": { "$ref": "../common/identifiers.v1.schema.json#/$defs/Version" },
            "customerRef": { "$ref": "../common/identifiers.v1.schema.json#/$defs/CustomerRef" },
            "confirmedAt": { "$ref": "../common/money-version-time.v1.schema.json#/$defs/Timestamp" },
            "contributionRevision": { "$ref": "../common/identifiers.v1.schema.json#/$defs/Version" }
          }
        }
      }
    }
  ]
}
