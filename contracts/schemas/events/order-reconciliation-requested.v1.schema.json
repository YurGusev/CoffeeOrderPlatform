{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffeeorderplatform.local/contracts/schemas/events/order-reconciliation-requested.v1.schema.json",
  "title": "OrderReconciliationRequested.v1",
  "allOf": [
    { "$ref": "../common/message-envelope.v1.schema.json#/$defs/MessageEnvelope" },
    {
      "type": "object",
      "required": ["messageType", "payload"],
      "properties": {
        "messageType": { "const": "OrderReconciliationRequested.v1" },
        "producer": { "const": "orders-service" },
        "aggregate": {
          "type": "object",
          "properties": {
            "type": { "const": "Order" },
            "ref": { "$ref": "../common/identifiers.v1.schema.json#/$defs/OrderRef" }
          }
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["orderRef", "orderVersion", "requestedAt"],
          "properties": {
            "orderRef": { "$ref": "../common/identifiers.v1.schema.json#/$defs/OrderRef" },
            "orderVersion": { "$ref": "../common/identifiers.v1.schema.json#/$defs/Version" },
            "requestedAt": { "$ref": "../common/money-version-time.v1.schema.json#/$defs/Timestamp" }
          }
        }
      }
    }
  ]
}
