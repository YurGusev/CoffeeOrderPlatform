      "dbPrincipal": "coffee_orders_observer_rw",
      "httpSurfaces": ["health-only"],
      "secretRefs": ["postgres.aromaObserver", "kafka.orders", "security.serviceTransportKeys.aroma-observer", "telemetry.exporterToken"],
      "implemented": false
    },
    {
      "name": "aroma-convergence",
      "owner": "orders",
      "m20Traceability": { "classification": "exact-role-ref", "roleRef": "aroma-convergence" },
      "networkZone": "internal-api",
      "dbPrincipal": "coffee_orders_convergence_rw",
      "httpSurfaces": ["health-only"],
