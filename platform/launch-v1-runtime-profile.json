      "implemented": false
    },
    {
      "name": "orders-service",
      "owner": "orders",
      "m20Traceability": { "classification": "launch-v1-only", "roleRef": null },
      "networkZone": "internal-api",
      "dbPrincipal": "coffee_orders_service_rw",
      "httpSurfaces": ["client-v1-owner"],
      "secretRefs": ["postgres.ordersService", "kafka.orders", "security.serviceTransportKeys.orders-service", "telemetry.exporterToken"],
      "implemented": false
    },
    {
      "name": "orders-aroma-preparation",
      "owner": "orders",
      "m20Traceability": { "classification": "exact-role-ref", "roleRef": "orders-aroma-preparation" },
      "networkZone": "internal-api",
      "dbPrincipal": "coffee_orders_prepare_rw",
      "httpSurfaces": ["health-only"],
