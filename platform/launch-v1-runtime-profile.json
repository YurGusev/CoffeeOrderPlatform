      "networkZone": "provider-egress",
      "dbPrincipal": "coffee_aroma_gateway_rw",
      "httpSurfaces": ["internal-v1-owner", "provider-outbound"],
      "secretRefs": ["postgres.aromaGateway", "aroma.email", "aroma.password", "aroma.sessionEncryptionKey", "aroma.catalogIdentityKeyV1", "security.serviceTransportKeys.aroma-gateway", "telemetry.exporterToken"],
      "implemented": false
    },
    {
      "name": "realtime-gateway",
      "owner": "realtime",
      "m20Traceability": { "classification": "exact-role-ref", "roleRef": "realtime-gateway" },
      "networkZone": "public-ingress",
      "dbPrincipal": null,
