  "specialRoles": {
    "api-agent": {
      "classification": "deployable-runtime-role",
      "state": "planned",
      "implemented": false,
      "deployedInFirstLaunch": false,
      "composeEntryAllowed": false
    },
    "config-bootstrap": {
      "classification": "trusted-initialization-provisioning-role",
      "lifecycle": "init-only",
      "longRunning": false,
      "listenerAllowed": false,
      "replicasAllowed": false
    }
  },
  "routeMounts": [
    {
      "source": "edge-nginx",
      "method": "ANY",
      "path": "/api/client-v1/**",
      "target": "api-public",
      "targetPort": 4050
    },
    {
      "source": "edge-nginx",
      "method": "GET",
      "path": "/events",
      "target": "realtime-gateway",
      "targetPort": 4401
    }
  ],
  "surfaceIsolation": {
    "api-public": [
      "client-v1"
    ],
    "api-internal": [
      "internal-v1"
    ],
    "edgeDirectOwnerRoutingAllowed": false,
    "ownerHostPortPublishingAllowed": false,
    "nativeNginxPublishedBind": "127.0.0.1:8443"
  },
  "internalOperationAllowlist": [
    {
      "originalCaller": "orders-service",
      "target": "customer-service",
      "method": "GET",
      "path": "/api/internal-v1/customers/{customerRef}/order-input",
      "operationId": "getCustomerOrderInput",
      "mutation": false
    },
    {
      "originalCaller": "pricing-service",
      "target": "catalog-service",
      "method": "GET",
      "path": "/api/internal-v1/catalog/products/{productRef}/variants/{variantRef}/pricing-input",
      "operationId": "getCatalogPricingInput",
      "mutation": false
    },
    {
      "originalCaller": "orders-service",
      "target": "pricing-service",
      "method": "POST",
      "path": "/api/internal-v1/pricing/quotes:verify",
      "operationId": "verifyPricingQuote",
      "mutation": false
    },
    {
      "originalCaller": "catalog-supplier-sync",
      "target": "aroma-gateway",
      "method": "POST",
      "path": "/api/internal-v1/aroma/catalog-exports",
      "operationId": "exportAromaCatalog",
      "mutation": false
    },
    {
      "originalCaller": "catalog-activation-worker",
      "target": "aroma-gateway",
      "method": "POST",
      "path": "/api/internal-v1/aroma/offer-bindings",
      "operationId": "registerAromaOfferBinding",
      "mutation": false
    },
    {
      "originalCaller": "aroma-observer",
      "target": "aroma-gateway",
      "method": "POST",
