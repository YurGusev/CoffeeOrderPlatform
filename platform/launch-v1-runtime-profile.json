      "networkZone": "internal-api",
      "dbPrincipal": "coffee_customer_rw",
      "httpSurfaces": ["client-v1-owner", "internal-v1-owner"],
      "secretRefs": ["postgres.customer", "security.serviceTransportKeys.customer-service", "telemetry.exporterToken"],
