      "owner": "catalog",
      "m20Traceability": { "classification": "exact-role-ref", "roleRef": "catalog-supplier-sync" },
      "networkZone": "internal-api",
      "dbPrincipal": "coffee_catalog_import_rw",
      "httpSurfaces": ["health-only"],
      "secretRefs": ["postgres.catalogImport", "security.serviceTransportKeys.catalog-supplier-sync", "telemetry.exporterToken"],
      "implemented": false
    },
    {
      "name": "catalog-activation-worker",
      "owner": "catalog",
      "m20Traceability": { "classification": "launch-v1-only", "roleRef": null },
      "networkZone": "internal-api",
      "dbPrincipal": "coffee_catalog_activate_rw",
      "httpSurfaces": [],
      "secretRefs": ["postgres.catalogActivate", "kafka.catalog", "security.serviceTransportKeys.catalog-activation-worker", "telemetry.exporterToken"],
      "implemented": false
    },
    {
      "name": "pricing-service",
      "owner": "pricing",
      "m20Traceability": { "classification": "launch-v1-only", "roleRef": null },
