    {
      "name": "catalog-service",
      "owner": "catalog",
      "m20Traceability": { "classification": "launch-v1-only", "roleRef": null },
      "networkZone": "internal-api",
      "dbPrincipal": "coffee_catalog_api_ro",
      "httpSurfaces": ["client-v1-owner", "internal-v1-owner"],
