{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffeeorderplatform.local/schemas/runtime-foundation-decision.v1.schema.json",
  "title": "CoffeeOrderPlatform runtime foundation decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "decisionId",
    "decisionRef",
    "runtime",
    "productionImage",
    "registryVerification",
    "toolchainDecision",
    "prohibitions",
    "materializationOwner"
  ],
  "properties": {
    "$schema": { "const": "./runtime-foundation-decision.schema.json" },
    "schemaVersion": { "const": 1 },
    "decisionId": { "const": "ADR-COP-RUNTIME-001" },
    "decisionRef": {
      "const": "docs/adr/ADR-0019-greenfield-node26-and-service-topology.md"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "npm", "corepack", "packageManager"],
      "properties": {
        "node": { "const": "26.8.1" },
        "npm": { "const": "11.19.0" },
        "corepack": { "const": "0.35.0" },
        "packageManager": { "const": "pnpm@11.24.0" }
      }
    },
    "productionImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "indexDigest",
        "platform",
        "platformManifestDigest",
        "reference"
      ],
      "properties": {
        "repository": { "const": "docker.io/library/node" },
        "tag": { "const": "26.8.1-alpine" },
        "indexDigest": {
          "const": "sha256:2d984a15c9b54fd0aeb608b8e0d0d83529eb34d2966db27a1fb4f1edc3d298a3"
        },
        "platform": { "const": "linux/amd64" },
        "platformManifestDigest": {
          "const": "sha256:ad6400dee476b06e82d0ee3a088e2d7555f6e6569c346e61d69e14d0f19e8c2b"
        },
        "reference": {
          "const": "node:26.8.1-alpine@sha256:2d984a15c9b54fd0aeb608b8e0d0d83529eb34d2966db27a1fb4f1edc3d298a3"
        }
      }
    },
    "registryVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifiedAt", "command", "digestPolicy"],
      "properties": {
        "verifiedAt": { "type": "string", "format": "date" },
        "command": {
          "const": "docker buildx imagetools inspect node:26.8.1-alpine"
        },
        "digestPolicy": {
          "const": "pin-index-and-verify-target-platform-manifest"
        }
      }
    },
    "toolchainDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionId",
        "decisionRef",
        "typescript",
        "structuralLinter",
        "typeAwareLinter",
        "openApiGenerator",
        "openApiGeneratorPlugin",
        "generatorMode",
        "compilerLanes"
      ],
      "properties": {
        "decisionId": { "const": "ADR-COP-TS7-NATIVE-001" },
        "decisionRef": { "const": "docs/adr/ADR-0022-ts7-native-toolchain.md" },
        "typescript": { "const": "typescript@7.0.2" },
        "structuralLinter": { "const": "oxlint@1.80.0" },
        "typeAwareLinter": { "const": "oxlint-tsgolint@7.0.2001" },
        "openApiGenerator": {
          "const": "@hey-api/openapi-ts@0.0.0-next-20260824173136"
        },
        "openApiGeneratorPlugin": { "const": "@hey-api/typescript" },
        "generatorMode": { "const": "types-only" },
        "compilerLanes": { "const": 1 }
      }
    },
    "prohibitions": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "node-24",
          "floating-image-tag",
          "placeholder-digest",
          "typescript-5-or-6",
          "second-typescript-compiler",
          "nightly-toolchain-pin",
          "compiler-api",
          "custom-transformer"
        ]
      }
    },
    "materializationOwner": { "const": "issue-3" }
  }
}
