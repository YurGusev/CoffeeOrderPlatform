{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffee-platform.invalid/schemas/aroma-approval.schema.json",
  "title": "Подписанное разрешение controlled-live AROMA",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "candidateSha",
    "mode",
    "exceptionAuthority",
    "origin",
    "accountFingerprint",
    "issuedAtUtc",
    "expiresAtUtc",
    "approver",
    "keyId",
    "offerRef",
    "maximumQuantity"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "runId": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7}$"
    },
    "candidateSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "mode": { "type": "string", "const": "controlled-live-existing-account" },
    "exceptionAuthority": { "type": "string", "const": "user-2026-10-23" },
    "origin": {
      "type": "string",
      "minLength": 9,
      "maxLength": 512,
      "pattern": "^https://[^/?#\\s]+$"
    },
    "accountFingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "issuedAtUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$"
    },
    "expiresAtUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$"
    },
    "approver": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "keyId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "offerRef": { "type": "string", "pattern": "^off_[0-9A-HJKMNP-TV-Z]{26}$" },
    "maximumQuantity": { "type": "string", "enum": ["1", "2"] }
  }
}
