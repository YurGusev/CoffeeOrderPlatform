{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffeeorderplatform.local/verification/launch/v1/matrix.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "gates"],
  "properties": {
    "version": { "const": 1 },
    "gates": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "prefixItems": [
        { "$ref": "#/$defs/preflight" },
        { "$ref": "#/$defs/install" },
        { "$ref": "#/$defs/generated" },
        { "$ref": "#/$defs/static" },
        { "$ref": "#/$defs/unit" },
        { "$ref": "#/$defs/contracts" },
        { "$ref": "#/$defs/architecture" },
        { "$ref": "#/$defs/config_security" },
        { "$ref": "#/$defs/supply_chain" },
        { "$ref": "#/$defs/migrations" },
        { "$ref": "#/$defs/db_boundaries" },
        { "$ref": "#/$defs/integration" },
        { "$ref": "#/$defs/recovery" },
        { "$ref": "#/$defs/compose" },
        { "$ref": "#/$defs/observability" },
        { "$ref": "#/$defs/browser" },
        { "$ref": "#/$defs/aroma_sandbox" },
        { "$ref": "#/$defs/backup_restore" },
        { "$ref": "#/$defs/rollback" },
        { "$ref": "#/$defs/report" }
      ],
      "items": false
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "profile",
        "mandatory",
        "owner",
        "predecessors",
        "command",
        "timeout",
        "inputs",
        "expectedArtifacts",
        "passCriteria",
        "cleanup",
        "rerunPolicy"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "version": { "const": 1 },
        "admission": { "const": true },
        "profile": { "enum": ["fast", "release", "both"] },
        "mandatory": { "const": true },
        "owner": { "type": "string", "minLength": 1 },
        "predecessors": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "uniqueItems": true
        },
        "command": { "type": "string" },
        "timeout": { "type": "integer", "minimum": 1, "maximum": 2700 },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "expectedArtifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "passCriteria": { "type": "string", "minLength": 1 },
        "cleanup": { "type": "string" },
        "rerunPolicy": { "const": "new-run-id-only" }
      }
    },
    "preflight": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "required": ["admission"],
          "properties": {
            "id": { "const": "preflight" },
            "admission": { "const": true },
            "command": { "const": "pnpm launch:verify:preflight" },
            "timeout": { "const": 900 }
          }
        }
      ]
    },
    "install": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "install" },
            "command": { "const": "pnpm install --frozen-lockfile" },
            "timeout": { "const": 900 }
          }
        }
      ]
    },
    "generated": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "generated" },
            "command": { "const": "pnpm contracts:check-generated" },
            "timeout": { "const": 900 }
          }
        }
      ]
    },
    "static": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "static" },
            "command": {
              "const": "pnpm format:check && pnpm lint && pnpm typecheck"
            },
            "timeout": { "const": 900 }
          }
        }
      ]
    },
    "unit": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "unit" },
            "command": { "const": "pnpm test:unit -- --coverage" },
            "timeout": { "const": 900 }
          }
        }
      ]
    },
    "contracts": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "contracts" },
            "command": {
              "const": "pnpm contracts:check-generated && pnpm contracts:breaking && pnpm contracts:test"
            },
            "timeout": { "const": 900 }
          }
        }
      ]
    },
    "architecture": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "architecture" },
            "command": { "const": "pnpm architecture:check" },
            "timeout": { "const": 900 }
          }
        }
      ]
    },
    "config_security": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "config_security" },
            "command": {
              "const": "pnpm versions:check && pnpm config:check && pnpm security:secrets"
            },
            "timeout": { "const": 900 }
          }
        }
      ]
    },
    "migrations": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "migrations" },
            "command": {
              "const": "pnpm test:migrations:clean && pnpm test:migrations:forward"
            },
            "timeout": { "const": 1800 }
          }
        }
      ]
    },
    "db_boundaries": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "db_boundaries" },
            "command": { "const": "pnpm db:smoke" },
            "timeout": { "const": 1800 }
          }
        }
      ]
    },
    "integration": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "integration" },
            "command": { "const": "pnpm test:integration" },
            "timeout": { "const": 1800 }
          }
        }
      ]
    },
    "recovery": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "recovery" },
            "command": { "const": "pnpm test:recovery" },
            "timeout": { "const": 1800 }
          }
        }
      ]
    },
    "supply_chain": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "supply_chain" },
            "command": { "const": "pnpm security:scan" },
            "timeout": { "const": 2700 }
          }
        }
      ]
    },
    "compose": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "compose" },
            "command": { "const": "pnpm test:compose-smoke" },
            "timeout": { "const": 1800 }
          }
        }
      ]
    },
    "observability": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "observability" },
            "command": { "const": "pnpm test:observability" },
            "timeout": { "const": 2700 }
          }
        }
      ]
    },
    "browser": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "browser" },
            "command": { "const": "pnpm test:playwright" },
            "timeout": { "const": 1800 }
          }
        }
      ]
    },
    "aroma_sandbox": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "aroma_sandbox" },
            "command": {
              "const": "pnpm test:aroma-sandbox -- --approval-file \"$AROMA_SANDBOX_APPROVAL_FILE\""
            },
            "timeout": { "const": 1800 }
          }
        }
      ]
    },
    "backup_restore": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "backup_restore" },
            "command": { "const": "pnpm test:backup-restore" },
            "timeout": { "const": 1800 }
          }
        }
      ]
    },
    "rollback": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "rollback" },
            "command": { "const": "pnpm test:mutation-disable-rollback" },
            "timeout": { "const": 1800 }
          }
        }
      ]
    },
    "report": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "report" },
            "command": { "const": "pnpm launch:verify:report" },
            "timeout": { "const": 900 }
          }
        }
      ]
    }
  }
}
