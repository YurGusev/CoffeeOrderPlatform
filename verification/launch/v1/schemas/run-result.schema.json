{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffeeorderplatform.local/verification/launch/v1/run-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "candidateSha",
    "sourceSha",
    "startedAt",
    "endedAt",
    "environment",
    "gates",
    "decision"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7}$"
    },
    "candidateSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sourceSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "dirty",
        "platform",
        "osRelease",
        "arch",
        "cpuCount",
        "memoryBytes",
        "node",
        "pnpm",
        "nodeImageDigest",
        "timezone",
        "candidatePath",
        "treeSha",
        "toolVersions",
        "configSha256",
        "encryptedSecretsSha256",
        "toolchainVersionsSha256",
        "lockfileSha256",
        "imageDigests",
        "resources"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7}$"
        },
        "dirty": { "const": false },
        "platform": { "type": "string" },
        "osRelease": { "type": "string" },
        "arch": { "type": "string" },
        "cpuCount": { "type": "integer", "minimum": 1 },
        "memoryBytes": { "type": "integer", "minimum": 1 },
        "node": { "type": "string" },
        "pnpm": { "type": "string" },
        "nodeImageDigest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "treeSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "timezone": { "type": "string" },
        "candidatePath": { "type": "string" },
        "toolVersions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["docker", "compose", "postgres", "kafka", "browser"],
          "properties": {
            "docker": { "type": ["string", "null"] },
            "compose": { "type": ["string", "null"] },
            "postgres": { "type": ["string", "null"] },
            "kafka": { "type": ["string", "null"] },
            "browser": { "type": ["string", "null"] }
          }
        },
        "configSha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "encryptedSecretsSha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "toolchainVersionsSha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "lockfileSha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "imageDigests": {
          "type": ["array", "null"],
          "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["composeProject", "databases", "kafkaPrefix"],
          "properties": {
            "composeProject": { "$ref": "#/$defs/declaredResource" },
            "databases": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": { "$ref": "#/$defs/declaredResource" }
            },
            "kafkaPrefix": { "$ref": "#/$defs/declaredResource" }
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "prefixItems": [
        { "$ref": "#/$defs/preflight" },
        { "$ref": "#/$defs/install" },
        { "$ref": "#/$defs/generated" },
        { "$ref": "#/$defs/static" },
        { "$ref": "#/$defs/unit" },
        { "$ref": "#/$defs/contracts" },
        { "$ref": "#/$defs/architecture" },
        { "$ref": "#/$defs/config_security" },
        { "$ref": "#/$defs/supply_chain" },
        { "$ref": "#/$defs/migrations" },
        { "$ref": "#/$defs/db_boundaries" },
        { "$ref": "#/$defs/integration" },
        { "$ref": "#/$defs/recovery" },
        { "$ref": "#/$defs/compose" },
        { "$ref": "#/$defs/observability" },
        { "$ref": "#/$defs/browser" },
        { "$ref": "#/$defs/aroma_sandbox" },
        { "$ref": "#/$defs/backup_restore" },
        { "$ref": "#/$defs/rollback" },
        { "$ref": "#/$defs/report" }
      ],
      "items": false
    },
    "decision": { "enum": ["ДОПУСТИТЬ", "НЕ ДОПУСТИТЬ"] }
  },
  "$defs": {
    "declaredResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "created"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "created": { "const": false }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "expectedCommand",
        "startedAt",
        "endedAt",
        "durationMs",
        "timeoutSeconds",
        "runs",
        "artifacts"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "status": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "expectedCommand": { "type": "string" },
        "startedAt": { "type": ["string", "null"], "format": "date-time" },
        "endedAt": { "type": ["string", "null"], "format": "date-time" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string" },
        "runs": { "type": "array", "items": { "$ref": "#/$defs/commandRun" } },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "commandRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "cwd",
        "startedAt",
        "endedAt",
        "exitCode",
        "timedOut",
        "outputLimitExceeded",
        "timeoutMs",
        "durationMs",
        "peakRssBytes",
        "artifacts"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "cwd": { "type": "string" },
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time" },
        "exitCode": { "type": ["integer", "null"] },
        "timedOut": { "type": "boolean" },
        "outputLimitExceeded": { "type": "boolean" },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "spawnError": { "type": "string" },
        "peakRssBytes": { "type": ["integer", "null"], "minimum": 0 },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "sizeBytes"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "preflight": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "preflight" },
            "expectedCommand": { "const": "pnpm launch:verify:preflight" },
            "timeoutSeconds": { "const": 900 }
          }
        }
      ]
    },
    "install": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "install" },
            "expectedCommand": { "const": "pnpm install --frozen-lockfile" },
            "timeoutSeconds": { "const": 900 }
          }
        }
      ]
    },
    "generated": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "generated" },
            "expectedCommand": { "const": "pnpm contracts:check-generated" },
            "timeoutSeconds": { "const": 900 }
          }
        }
      ]
    },
    "static": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "static" },
            "expectedCommand": {
              "const": "pnpm format:check && pnpm lint && pnpm typecheck"
            },
            "timeoutSeconds": { "const": 900 }
          }
        }
      ]
    },
    "unit": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "unit" },
            "expectedCommand": { "const": "pnpm test:unit -- --coverage" },
            "timeoutSeconds": { "const": 900 }
          }
        }
      ]
    },
    "contracts": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "contracts" },
            "expectedCommand": {
              "const": "pnpm contracts:check-generated && pnpm contracts:breaking && pnpm contracts:test"
            },
            "timeoutSeconds": { "const": 900 }
          }
        }
      ]
    },
    "architecture": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "architecture" },
            "expectedCommand": { "const": "pnpm architecture:check" },
            "timeoutSeconds": { "const": 900 }
          }
        }
      ]
    },
    "config_security": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "config_security" },
            "expectedCommand": {
              "const": "pnpm versions:check && pnpm config:check && pnpm security:secrets"
            },
            "timeoutSeconds": { "const": 900 }
          }
        }
      ]
    },
    "migrations": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "migrations" },
            "expectedCommand": {
              "const": "pnpm test:migrations:clean && pnpm test:migrations:forward"
            },
            "timeoutSeconds": { "const": 1800 }
          }
        }
      ]
    },
    "db_boundaries": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "db_boundaries" },
            "expectedCommand": { "const": "pnpm db:smoke" },
            "timeoutSeconds": { "const": 1800 }
          }
        }
      ]
    },
    "integration": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "integration" },
            "expectedCommand": { "const": "pnpm test:integration" },
            "timeoutSeconds": { "const": 1800 }
          }
        }
      ]
    },
    "recovery": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "recovery" },
            "expectedCommand": { "const": "pnpm test:recovery" },
            "timeoutSeconds": { "const": 1800 }
          }
        }
      ]
    },
    "supply_chain": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "supply_chain" },
            "expectedCommand": { "const": "pnpm security:scan" },
            "timeoutSeconds": { "const": 2700 }
          }
        }
      ]
    },
    "compose": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "compose" },
            "expectedCommand": { "const": "pnpm test:compose-smoke" },
            "timeoutSeconds": { "const": 1800 }
          }
        }
      ]
    },
    "observability": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "observability" },
            "expectedCommand": { "const": "pnpm test:observability" },
            "timeoutSeconds": { "const": 1800 }
          }
        }
      ]
    },
    "browser": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "browser" },
            "expectedCommand": { "const": "pnpm test:playwright" },
            "timeoutSeconds": { "const": 1800 }
          }
        }
      ]
    },
    "aroma_sandbox": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "aroma_sandbox" },
            "expectedCommand": {
              "const": "pnpm test:aroma-sandbox -- --approval-file \"$AROMA_SANDBOX_APPROVAL_FILE\""
            },
            "timeoutSeconds": { "const": 1800 }
          }
        }
      ]
    },
    "backup_restore": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "backup_restore" },
            "expectedCommand": { "const": "pnpm test:backup-restore" },
            "timeoutSeconds": { "const": 1800 }
          }
        }
      ]
    },
    "rollback": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "rollback" },
            "expectedCommand": {
              "const": "pnpm test:mutation-disable-rollback"
            },
            "timeoutSeconds": { "const": 1800 }
          }
        }
      ]
    },
    "report": {
      "allOf": [
        { "$ref": "#/$defs/gate" },
        {
          "type": "object",
          "properties": {
            "id": { "const": "report" },
            "expectedCommand": { "const": "pnpm launch:verify:report" },
            "timeoutSeconds": { "const": 900 }
          }
        }
      ]
    }
  }
}
